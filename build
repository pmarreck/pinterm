#!/usr/bin/env bash
# Build the optimized native pinterm game: Roc core archive + C terminal/audio host.
# Usage: ./build [--target TARGET] [--out DIR] [--debug] [--check-only]
# TARGET: x86_64-linux, aarch64-linux, aarch64-macos, x86_64-windows or
#         aarch64-windows (default: this machine).
# Outputs: DIR/release/bin/pinterm (pinterm.exe on Windows; debug/ with --debug).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage_error() { echo "build: $*" >&2; exit 2; }
target=""
target_given=0
out=""
profile=release
check_only=0
while [ $# -gt 0 ]; do
	case "$1" in
		--target) [ $# -ge 2 ] || usage_error "--target needs a value"; target="$2"; target_given=1; shift 2 ;;
		--out) [ $# -ge 2 ] || usage_error "--out needs a value"; out="$2"; shift 2 ;;
		--debug) profile=debug; shift ;;
		--test) shift ;; # tests use the same optimized artifact
		--check-only) check_only=1; shift ;;
		-h|--help) sed -n '2,6p' "$0"; exit 0 ;;
		*) usage_error "unknown argument: $1" ;;
	esac
done

if [ "$target_given" = 0 ]; then
	case "$(uname -s)/$(uname -m)" in
		Linux/x86_64) target=x86_64-linux ;;
		Linux/aarch64) target=aarch64-linux ;;
		*) echo "build: Roc only builds on Linux; cross-build with --target aarch64-macos from a Linux machine" >&2; exit 1 ;;
	esac
	native=1
else
	native=0
fi
# Roc archive target, host object target, final link target, link flags.
# Linux links statically against musl; macOS cannot link statically; Windows
# links against MinGW with winmm for waveOut audio.
host_lib=libhost.a host_flags="-fPIC -fvisibility=hidden" libs=-lm exe=pinterm
case "$target" in
	x86_64-linux) roc_target=x64v1glibc host_cc_target=x86_64-linux-gnu zig_target=x86_64-linux-musl link_static=-static ;;
	aarch64-linux) roc_target=arm64glibc host_cc_target=aarch64-linux-gnu zig_target=aarch64-linux-musl link_static=-static ;;
	aarch64-macos) roc_target=arm64mac host_cc_target=aarch64-macos zig_target=aarch64-macos link_static= ;;
	x86_64-windows | aarch64-windows)
		roc_target="$( [ "${target%%-*}" = x86_64 ] && echo x64win || echo arm64win )"
		host_cc_target="${target}-gnu" zig_target="${target}-gnu" link_static=-static
		host_lib=host.lib host_flags= libs=-lwinmm exe=pinterm.exe ;;
	*) usage_error "unknown target '$target' (expected x86_64-linux, aarch64-linux, aarch64-macos, x86_64-windows or aarch64-windows)" ;;
esac
arch="${target%%-*}" os="${target#*-}"

if [ -z "${PINTERM_ROC:-}" ]; then
	exec nix develop "$root" -c "$root/build" --target "$target" ${out:+--out "$out"} \
		$([ "$profile" = debug ] && echo --debug) $([ "$check_only" = 1 ] && echo --check-only)
fi

# Native builds keep the historical out/ tree; cross builds get their own.
default_out="$root/out"
[ "$native" = 1 ] || default_out="$root/out/$target"
[ -n "$out" ] || out="$default_out"
# The Roc compiler spawns one worker per CPU unless bounded; keep it modest.
jobs="${PINTERM_ROC_JOBS:-4}"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
work="$out/work"
mkdir -p "$work/platform/targets/$roc_target" "$work/src" "$out/$profile/bin"
cp "$root"/platform/*.roc "$root/platform/host.c" "$root/platform/pinterm_host.h" "$work/platform/"
cp "$root"/src/*.roc "$work/src/"

"$PINTERM_ROC" check "$work/src/main.roc" --no-cache --jobs="$jobs"
[ "$check_only" = 1 ] && exit 0

bash "$root/tools/roc-glue" "$work/platform"

if [ "$profile" = debug ]; then
	copt="-O0 -g -DPINTERM_DEBUG_BUILD=1"; ropt="--opt=dev"
else
	copt="-O2"; ropt="--opt=speed"
fi
warn="-Wall -Wextra -Werror -std=c11 -D_GNU_SOURCE"

# shellcheck disable=SC2086
zig cc -target "$host_cc_target" -mcpu=baseline $warn $copt $host_flags \
	-c "$work/platform/host.c" -o "$work/platform/host.o"
zig ar rcs "$work/platform/targets/$roc_target/$host_lib" "$work/platform/host.o"
"$PINTERM_ROC" build "$work/src/main.roc" $ropt --target="$roc_target" \
	--jobs="$jobs" --no-cache --output="$work/libpinterm.a"

# shellcheck disable=SC2086
zig cc -target "$zig_target" -mcpu=baseline $warn $copt $link_static \
	-I"$work/platform" -I"$root/host" \
	"$root"/host/*.c "$work/libpinterm.a" $libs -o "$out/$profile/bin/$exe"
echo "built $out/$profile/bin/$exe" >&2

# Publish the platform entrypoint (only for the default output tree, after success).
if [ "$out" = "$default_out" ]; then
	mkdir -p "$root/bin/$os/$arch"
	rel="${out#"$root/"}"
	ln -sfn "../../../$rel/$profile/bin/$exe" "$root/bin/$os/$arch/$exe"
	echo "published bin/$os/$arch/$exe -> $rel/$profile/bin/$exe" >&2
fi
