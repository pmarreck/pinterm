#!/usr/bin/env bash
# Complete pinterm test entry point: Roc core expectations, formatting, the
# optimized build (only when its inputs changed), CLI surface, headless
# gameplay replay, PCM capture, real-terminal cleanup, and the browser build
# (differential replay against native, headless Chromium session).
# Independent suites run in parallel; output is printed in a fixed order.
# Usage: ./test [--rebuild]   (force the optimized build even if up to date)
#        ./test --prebuilt    (test PINTERM_BIN and PINTERM_WEB as given; CI uses
#                             this to test the packaged builds without rebuilding)
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${PINTERM_ROC:-}" ]; then
	exec nix develop "$root" -c "$root/test" "$@"
fi
cd "$root" || exit 1
force_build=0
prebuilt=0
for arg in "$@"; do
	case "$arg" in
		--rebuild) force_build=1 ;;
		--prebuilt) prebuilt=1 ;;
		*) echo "test: unknown argument: $arg" >&2; exit 2 ;;
	esac
done
export MUTE_DEBUG_STATUS=1 PINTERM_MUTE=1
export PINTERM_BIN="${PINTERM_BIN:-$root/out/release/bin/pinterm}"
export PINTERM_WEB="${PINTERM_WEB:-$root/out/web}"
if [ "$prebuilt" = 1 ]; then
	[ -x "$PINTERM_BIN" ] || { echo "test: --prebuilt needs PINTERM_BIN to name a built pinterm (got $PINTERM_BIN)" >&2; exit 2; }
	[ -s "$PINTERM_WEB/pinterm.wasm" ] || { echo "test: --prebuilt needs PINTERM_WEB to name a built web site (got $PINTERM_WEB)" >&2; exit 2; }
fi
work="$(mktemp -d "${TMPDIR:-/tmp}/pinterm-test.XXXXXX")"
trap 'command rm -rf -- "$work"' EXIT
# Interactive test sessions would otherwise read and write the real per-user
# high-score file; give them a private data directory instead.
unset PINTERM_SCORES
export XDG_DATA_HOME="$work/xdg-data"
failed=()

# report NAME: print a finished job's captured output and record failure.
key() { printf '%s' "$1" | tr '/ ' '__'; }
report() {
	local name="$1" rc k
	k="$(key "$name")"
	rc="$(cat "$work/$k.rc" 2>/dev/null || echo 1)"
	printf '\033[36m==>\033[0m %s\n' "$name"
	cat "$work/$k.out" 2>/dev/null
	[ "$rc" = 0 ] || failed+=("$name")
}
# job NAME CMD...: run in the background, capturing output and status.
job() {
	local k; k="$(key "$1")"; shift
	( "$@" >"$work/$k.out" 2>&1; echo $? >"$work/$k.rc" ) &
}

build_stale() {
	[ "$force_build" = 1 ] && return 0
	[ -x "$PINTERM_BIN" ] || return 0
	# Test-only Roc files are not linked into the binary.
	[ -n "$(find src platform host nix build flake.nix flake.lock -newer "$PINTERM_BIN" ! -name "test_*.roc" ! -name TestKit.roc -print -quit 2>/dev/null)" ]
}
web_stale() {
	[ "$force_build" = 1 ] && return 0
	[ -s "$PINTERM_WEB/pinterm.wasm" ] || return 0
	[ -n "$(find src web build-web nix flake.nix flake.lock -newer "$PINTERM_WEB/pinterm.wasm" ! -name "test_*.roc" ! -name TestKit.roc -print -quit 2>/dev/null)" ]
}
web_build_step() {
	if [ "$prebuilt" = 1 ]; then
		echo "using prebuilt $PINTERM_WEB"
	elif web_stale; then
		./build-web --out "$PINTERM_WEB" || return 1
	else
		echo "up to date ($(realpath --relative-to="$root" "$PINTERM_WEB"))"
	fi
}
build_step() {
	if [ "$prebuilt" = 1 ]; then
		echo "using prebuilt $PINTERM_BIN"
	elif build_stale; then
		./build || return 1
	else
		echo "up to date ($(realpath --relative-to="$root" "$PINTERM_BIN"))"
	fi
}
roc_suite() { # Expectations per area; the compiler cache is keyed on source content.
	local out rc
	out="$("$PINTERM_ROC" test "src/$1.roc" --jobs="${PINTERM_ROC_JOBS:-8}" 2>&1)"
	rc=$?
	[ $rc -eq 0 ] && printf '%s\n' "$out" | tail -n 1 || printf '%s\n' "$out"
	return $rc
}
roc_fmt() { "$PINTERM_ROC" fmt --check src platform; }

# Phase 1: the build (if needed) overlaps the pure Roc suites.
job "optimized build" build_step
job "web build" web_build_step
roc_names=()
for f in src/test_*.roc; do
	name="roc ${f#src/}"
	roc_names+=("$name")
	job "$name" roc_suite "$(basename "$f" .roc)"
done
job "roc formatting" roc_fmt
wait
for name in "${roc_names[@]}" "roc formatting" "optimized build" "web build"; do report "$name"; done

# Phase 2: suites that exercise the built binary.
if [[ " ${failed[*]} " != *" optimized build "* && " ${failed[*]} " != *" web build "* ]]; then
	bin_names=()
	for t in tests/cli/*_test tests/integration/*_test tests/web/*_test tests/deploy/*_test; do
		[ -x "$t" ] || continue
		bin_names+=("$t")
		job "$t" "$t"
	done
	wait
	for name in "${bin_names[@]}"; do report "$name"; done
fi

if [ ${#failed[@]} -gt 0 ]; then
	printf '\033[31mFAILED:\033[0m %s\n' "${failed[@]}"
	exit 1
fi
printf '\033[32mall pinterm tests passed\033[0m\n'
