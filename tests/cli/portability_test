#!/usr/bin/env bash
# Every terminal host source compiles for macOS (arm64 and x86_64) with the same
# warnings-as-errors flags as the Linux build, and names the OS it was built
# for in --about. Cross-compiling with zig cc needs no Mac, and catches
# Linux-only calls (pipe2, F_SETPIPE_SZ, clock_nanosleep) before a Mac build
# does. Running on a Mac is outside this suite.
set -u
SUITE=portability
. "$(dirname "$0")/../lib/harness.sh"
root="$(cd "$(dirname "$0")/../.." && pwd)"
dir="$(mktemp -d "${TMPDIR:-/tmp}/pinterm-portability.XXXXXX")"
export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$dir/zig-cache}" ZIG_LOCAL_CACHE_DIR="$dir/zig-local"

for target in aarch64-macos x86_64-macos; do
	for src in "$root"/host/*.c; do
		name="$(basename "$src" .c)"
		capture zig cc -target "$target" -Wall -Wextra -Werror -std=c11 -D_GNU_SOURCE \
			-I"$root/platform" -c "$src" -o "$dir/$name-$target.o"
		check "host/$name.c compiles for $target" [ "$rc" -eq 0 ]
		check "host/$name.c compiles for $target without diagnostics" [ -z "$err" ]
	done
	check "$target --about names macos" grep -aq "macos" "$dir/platform_posix-$target.o"
	# The macOS object carries the real CoreAudio backend, not the stub.
	check "$target audio uses CoreAudio's AudioQueue" grep -aq "AudioQueueNewOutput" "$dir/audio_coreaudio-$target.o"
done

# The Roc ABI shim (allocator, hosted-function glue) compiles for every
# target, Windows included: MinGW has no aligned_alloc, and MSVC-ABI Roc
# objects need the _fltused marker.
mkdir -p "$dir/glue"
cp "$root"/platform/*.roc "$root/platform/pinterm_host.h" "$dir/glue/"
capture bash "$root/tools/roc-glue" "$dir/glue"
check "roc glue generates the platform ABI header" [ -s "$dir/glue/roc_platform_abi.h" ]
for target in x86_64-linux-gnu aarch64-linux-gnu aarch64-macos x86_64-windows-gnu aarch64-windows-gnu; do
	capture zig cc -target "$target" -Wall -Wextra -Werror -std=c11 -D_GNU_SOURCE \
		-I"$dir/glue" -I"$root/platform" -c "$root/platform/host.c" -o "$dir/shim-$target.o"
	check "platform/host.c compiles for $target" [ "$rc" -eq 0 ]
	check "platform/host.c compiles for $target without diagnostics" [ -z "$err" ]
done
check "Windows shim defines _fltused" grep -aq "_fltused" "$dir/shim-x86_64-windows-gnu.o"

# Every host target has a matching Roc target in the platform header.
for roc_target in x64v1glibc arm64glibc arm64mac x64mac x64win arm64win; do
	check "platform declares Roc target $roc_target" grep -Eq "^[[:space:]]+$roc_target: \{" "$root/platform/main.roc"
done

command rm -rf -- "$dir"
finish
