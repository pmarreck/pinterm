#!/usr/bin/env bash
# Browser build: the WebAssembly core must reproduce the native build exactly
# (same seed and keys -> identical event log and frame bytes), and the real
# page must run in headless Chromium driven by actual keyboard events.
set -u
SUITE=web
. "$(dirname "$0")/../lib/harness.sh"
root="$(cd "$(dirname "$0")/../.." && pwd)"
bin="${PINTERM_BIN:?}"
site="${PINTERM_WEB:-$root/out/web}"
dir="$(mktemp -d "${TMPDIR:-/tmp}/pinterm-web.XXXXXX")"

check "site has index.html" [ -s "$site/index.html" ]
check "site has a 12-hex build id" grep -Eqx "[0-9a-f]{12}" "$site/build-id.txt"
check "index.html carries the same build id" grep -q "<meta name=\"pinterm-build\" content=\"$(cat "$site/build-id.txt" 2>/dev/null)\">" "$site/index.html"
check "site has the game core" [ -s "$site/pinterm.wasm" ]
check "site has libghostty renderer" [ -s "$site/vendor/ghostty-vt.wasm" ] && [ -s "$site/vendor/ghostty-web.js" ]
check "site ships license notices" [ -s "$site/licenses/pinterm-MIT.txt" ] && [ -s "$site/licenses/ghostty-web-MIT.txt" ] && [ -s "$site/licenses/Roc-UPL.txt" ]

# Differential oracle: two independent hosts (C terminal host, JS/wasm host)
# around the same Roc core must agree byte for byte.
# Kitty-style input: every plunger and flipper press gets a release, so the
# core runs in exact-key mode exactly as it does in a browser.
awk 'BEGIN { print "5 space"; print "6 release-space"; for (f = 30; f < 12000; f++) { if (f % 600 == 0) print f " space"; else if (f % 600 == 40) print f " release-space"; else if (f % 23 == 0) print f " z"; else if (f % 23 == 6) print f " release-z"; else if (f % 29 == 0) print f " /"; else if (f % 29 == 7) print f " release-slash" } }' >"$dir/script"
for size in 100x40 80x24; do
	capture timeout 60 "$bin" --headless --size "$size" --frames 12000 --seed 11 --script "$dir/script" --frames-out "$dir/native-frames-$size" --log-out "$dir/native-log-$size"
	check "native replay at $size" [ "$rc" -eq 0 ]
	grep '^f=' "$dir/native-log-$size" >"$dir/native-events-$size"
	capture timeout 60 node "$root/tests/web/replay.mjs" "$site/pinterm.wasm" "$dir/script" 12000 "$size" 11 "$dir/web-frames-$size" "$dir/web-log-$size"
	check "wasm replay at $size ($err)" [ "$rc" -eq 0 ]
	check "replay produced gameplay events at $size" grep -q "event drain" "$dir/native-events-$size"
	check "wasm event log identical to native at $size" cmp -s "$dir/native-events-$size" "$dir/web-log-$size"
	check "wasm frame bytes identical to native at $size" cmp -s "$dir/native-frames-$size" "$dir/web-frames-$size"
done

# Every alternate table, selected with ] between games (slide frames included).
for t in 1 2 3 4; do
	awk -v t="$t" 'BEGIN { for (i = 0; i < t; i++) print 2 + 3 * i " ]"; print "60 space"; print "61 release-space"; for (f = 90; f < 4000; f++) { if (f % 600 == 0) print f " space"; else if (f % 600 == 40) print f " release-space"; else if (f % 23 == 0) print f " z"; else if (f % 23 == 6) print f " release-z"; else if (f % 29 == 0) print f " /"; else if (f % 29 == 7) print f " release-slash" } }' >"$dir/script-$t"
	capture timeout 60 "$bin" --headless --size 100x40 --frames 4000 --seed 11 --script "$dir/script-$t" --frames-out "$dir/native-frames-t$t" --log-out "$dir/native-log-t$t"
	check "native replay on table $t" [ "$rc" -eq 0 ]
	grep '^f=' "$dir/native-log-t$t" >"$dir/native-events-t$t"
	capture timeout 60 node "$root/tests/web/replay.mjs" "$site/pinterm.wasm" "$dir/script-$t" 4000 100x40 11 "$dir/web-frames-t$t" "$dir/web-log-t$t"
	check "wasm replay on table $t ($err)" [ "$rc" -eq 0 ]
	check "replay selected table $t" grep -q "event table index=$t " "$dir/native-events-t$t"
	check "replay launched on table $t" grep -q "event launch" "$dir/native-events-t$t"
	check "wasm event log identical to native on table $t" cmp -s "$dir/native-events-t$t" "$dir/web-log-t$t"
	check "wasm frame bytes identical to native on table $t" cmp -s "$dir/native-frames-t$t" "$dir/web-frames-t$t"
done

capture node --test "$root/tests/web/touch.test.mjs" "$root/tests/web/shake.test.mjs" "$root/tests/web/glyphs.test.mjs"
check "touch, shake and glyph unit tests ($(grep -E "^. (pass|fail)" <<<"$out" | tr "\n" " "))" [ "$rc" -eq 0 ]

# Real browser, real key events.
if command -v chromium >/dev/null; then
	capture timeout 90 node "$root/tests/web/browser.mjs" "$site" check
	check "browser session ran ($err)" [ "$rc" -eq 0 ]
	check "start overlay shown before input" grep -q '"overlayBefore":false' <<<"$out"
	check "] key switched to the next table" grep -q '"switched":"f=[0-9]* event table index=1 name=ORBITAL"' <<<"$out"
	check "space started a game in the browser" grep -q '"started":"f=[0-9]* event start' <<<"$out"
	check "held plunger launched with measured power" grep -Eq '"launched":"f=[0-9]+ event launch power=([1-9][0-9]?)"' <<<"$out"
	check "z key flipped the left flipper" grep -q '"flipped":"f=[0-9]* event flip side=left"' <<<"$out"
	check "Web Audio available" grep -q '"audio":"function"' <<<"$out"
	check "playfield glyphs drawn as shapes, never through the font" grep -Eq '"fillText":\{"shapes":0,"other":[1-9][0-9]*\}' <<<"$out"
	check "no diagnostic overlay without ?diag" grep -q '"diag":null' <<<"$out"
	check "no page errors" grep -q '"problems":\[\]' <<<"$out"
	capture timeout 90 node "$root/tests/web/browser.mjs" "$site" touch
	check "touch session ran ($err)" [ "$rc" -eq 0 ]
	check "tap dismissed the start overlay" grep -q '"overlayGone":true' <<<"$out"
	check "sideways swipe switched to the next table" grep -q '"switched":"f=[0-9]* event table index=1 name=ORBITAL"' <<<"$out"
	check "swipe started a game" grep -q '"started":"f=[0-9]* event start' <<<"$out"
	check "full swipe launched at full power" grep -Eq '"launched":"f=[0-9]+ event launch power=(9[0-9]|100)"' <<<"$out"
	check "lower-left tap flipped left" grep -q '"left":"f=[0-9]* event flip side=left"' <<<"$out"
	check "lower-right tap flipped right" grep -q '"right":"f=[0-9]* event flip side=right"' <<<"$out"
	check "no editable element can raise a keyboard" grep -q '"editable":0' <<<"$out"
	check "focus never lands on a text input" bash -c '! grep -Eq "\"focus\":\"(TEXTAREA|INPUT|[A-Z]+:editable)\"" <<<"$1"' _ "$out"
	check "device bump nudged the table" grep -q '"nudged":"f=[0-9]* event nudge' <<<"$out"
	check "?diag overlay shows the swipe classification" grep -q '"diag":"[^"]*gesture swipe-left dx -[0-9]* dy -\?[0-9]* keys ]:down ]:up' <<<"$out"
	check "?diag overlay shows a current build id" grep -Eq '"diag":"build [0-9a-f]{12} served [0-9a-f]{12} ok' <<<"$out"
	check "no page errors on touch" grep -q '"problems":\[\]' <<<"$out"
else
	fail "chromium unavailable: browser session not verified"
fi
command rm -rf -- "$dir"
finish
