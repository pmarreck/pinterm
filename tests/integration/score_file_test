#!/usr/bin/env bash
# Independent check of the saved score file format: decode it with the
# printable-binary CLI, decrypt it with the reference TEA code (Wheeler and
# Needham) in counter mode, and verify the appended checksum with b3sum. None
# of these oracles share code with the Roc core that wrote the file.
set -u
SUITE=score-file
. "$(dirname "$0")/../lib/harness.sh"
bin="${PINTERM_BIN:?}"
unset PINTERM_SCORES

dir="$(mktemp -d "${TMPDIR:-/tmp}/pinterm-score-file.XXXXXX")"
script="$dir/game"
awk 'BEGIN { print "5 space"; for (f = 30; f < 6000; f++) { if (f % 600 == 0) print f " space"; else if (f % 600 >= 300 && f % 600 < 303) print f " /"; else if (f % 23 == 0) print f " z"; else if (f % 29 == 0) print f " /" } }' >"$script"
capture timeout 60 "$bin" --headless --size 100x40 --frames 6000 --seed 7 --script "$script" --log-out "$dir/log" --scores "$dir/scores.txt"
check "game saved a score file" [ -s "$dir/scores.txt" ]
entry="$(grep -o 'event initials table=0 text="[^"]*" score=[0-9]*' "$dir/log")"
initials="$(sed -E 's/.*text="([^"]*)".*/\1/' <<<"$entry")"
score="${entry##*score=}"

# The Roc codec files in src/ are verbatim copies from the pinned printable-binary
# flake input; any local edit or pin bump without a re-copy fails here.
src_pb="${PINTERM_PRINTABLE_BINARY_SRC:?}"
root="$(cd "$(dirname "$0")/../.." && pwd)"
check "src/Codec.roc matches the pinned printable-binary" cmp -s "$root/src/Codec.roc" "$src_pb/roc/Codec.roc"
check "src/Map.roc matches the pinned printable-binary" cmp -s "$root/src/Map.roc" "$src_pb/roc/Map.roc"

check "first line names the format" [ "$(head -n 1 "$dir/scores.txt")" = "pinterm scores 1" ]
check "file is two lines" [ "$(wc -l <"$dir/scores.txt")" -eq 2 ]
tail -n +2 "$dir/scores.txt" | tr -d '\n' | printable-binary -d >"$dir/sealed" 2>"$dir/pb.err"
check "printable-binary decodes the body" [ -s "$dir/sealed" ]
check "re-encoding reproduces the body" [ "$(printable-binary <"$dir/sealed" 2>>"$dir/pb.err")" = "$(tail -n +2 "$dir/scores.txt" | tr -d '\n')" ]

# Reference TEA, keystream block i = TEA(key, (nonce, i)), words little-endian.
cat >"$dir/tea_ctr.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
static void encrypt(uint32_t v[2], const uint32_t k[4]) {
	uint32_t v0 = v[0], v1 = v[1], sum = 0, delta = 0x9E3779B9;
	for (int i = 0; i < 32; i++) {
		sum += delta;
		v0 += ((v1 << 4) + k[0]) ^ (v1 + sum) ^ ((v1 >> 5) + k[1]);
		v1 += ((v0 << 4) + k[2]) ^ (v0 + sum) ^ ((v0 >> 5) + k[3]);
	}
	v[0] = v0; v[1] = v1;
}
int main(void) {
	const uint32_t key[4] = {0x99315377, 0xDC83993C, 0xAF31119E, 0x726C0801};
	uint8_t n[4];
	if (fread(n, 1, 4, stdin) != 4) return 1;
	uint32_t nonce = n[0] | n[1] << 8 | n[2] << 16 | (uint32_t)n[3] << 24;
	uint8_t stream[8];
	int c;
	for (uint32_t i = 0; (c = getchar()) != EOF; i++) {
		if (i % 8 == 0) {
			uint32_t v[2] = {nonce, i / 8};
			encrypt(v, key);
			for (int b = 0; b < 4; b++) { stream[b] = v[0] >> (8 * b); stream[4 + b] = v[1] >> (8 * b); }
		}
		putchar(c ^ stream[i % 8]);
	}
	return 0;
}
EOF
capture zig cc -O2 -o "$dir/tea_ctr" "$dir/tea_ctr.c"
check "reference TEA compiles" [ "$rc" -eq 0 ]
"$dir/tea_ctr" <"$dir/sealed" >"$dir/plain"
size="$(wc -c <"$dir/plain")"
head -c $((size - 64)) "$dir/plain" >"$dir/body"
digest="$(tail -c 64 "$dir/plain")"
check "BLAKE3 of the body matches the appended hex" [ "$(b3sum --no-names "$dir/body")" = "$digest" ]
check "plaintext header" [ "$(head -n 1 "$dir/body")" = "pinterm-scores 1" ]
check "plaintext holds the locked-in entry" [ "$(sed -n 2p "$dir/body")" = "0 $initials $score" ]

command rm -rf -- "$dir"
finish
